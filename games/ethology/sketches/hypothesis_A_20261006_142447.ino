#include <Servo.h>
#include "CogServo.h"
#include "EthologyRobot.h"


EthologyRobot bot;

void hierarchy() {
  if (true) {  // Cruise Straight
    bot.cruiseStraight();
  }
}

void setup() {
  Serial.begin(9600);
  
  bot.begin(6, 5);

  // cruise_arc picks a direction with random() and holds it. Without
  // a seed every power cycle replays the same sequence of turns, so
  // two robots side by side would arc identically.
  randomSeed(analogRead(A5));
}

void loop() {
  // Sense first. readSensors() halts the motors and samples every
  // sensor once, so all guards below see the same reading and a tick
  // where nothing fires leaves the robot stopped.
  bot.readSensors();
  hierarchy();
}
